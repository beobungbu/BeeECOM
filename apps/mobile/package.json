{
  "name": "@beeecom/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist-web",
    "bundle:ios": "expo export --platform ios --output-dir dist-ios",
    "bundle:android": "expo export --platform android --output-dir dist-android",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@beeecom/api-client": "workspace:*",
    "@beeecom/app-ui": "workspace:*",
    "@beeecom/domain": "workspace:*",
    "@beemvp/beeui-core": "0.86.2-rc.1",
    "@beemvp/beeui-tokens": "0.86.2-rc.1",
    "@beemvp/beeui-ui": "0.86.2-rc.1",
    "@expo/metro-runtime": "57.0.14",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "57.0.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "5.7.0",
    "react-native-teleport": "1.1.13",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.10.4",
    "tailwindcss": "4.3.3",
    "uniwind": "1.10.1"
  }
