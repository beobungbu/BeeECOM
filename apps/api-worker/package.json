{
  "name": "@beeecom/api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply beeecom-demo --local",
    "db:migrate:remote": "wrangler d1 migrations apply beeecom-demo --remote",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@beeecom/contracts": "workspace:*",
    "@beeecom/domain": "workspace:*",
    "@beeecom/dummy-data": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
