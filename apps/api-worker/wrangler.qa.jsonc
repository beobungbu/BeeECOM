{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beeecom-api-qa",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-09",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beeecom-demo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "DEFAULT_SCENARIO": "healthy",
    "CORS_ORIGINS": "http://127.0.0.1:5173,http://127.0.0.1:5174",
    "DEMO_RESET_TOKEN": "qa-reset-token"
  }
}
